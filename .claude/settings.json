{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/mixxeo/my-claude-code-os/.claude/hooks/skill-start.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/mixxeo/my-claude-code-os/.claude/hooks/skill-end.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/mixxeo/my-claude-code-os/.claude/hooks/protect-retros.sh"
          }
        ]
      }
    ]
  }
}
